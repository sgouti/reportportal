# Credentials for ReportPortal infrastructure
POSTGRES_USER=rpuser
POSTGRES_PASSWORD=rppass
POSTGRES_DB=reportportal
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq
RP_INITIAL_ADMIN_PASSWORD=erebus

# Images for ReportPortal services
MIGRATIONS_IMAGE=
INDEX_IMAGE=
UI_IMAGE=
API_IMAGE=
UAT_IMAGE=
JOBS_IMAGE=
ANALYZER_IMAGE=

# Analyzer semantic model baking for compose builds.
# Set ANALYZER_BAKE_MODELS=true to embed the runtime ONNX models into the analyzer image
# before `docker compose build` / `docker compose up --build`.
# Leave it false if you install the model assets separately at runtime.
ANALYZER_BAKE_MODELS=false
HF_TOKEN=
